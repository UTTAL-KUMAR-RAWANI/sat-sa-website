# ==============================================================================
# SAT-SA Platform Environment Configuration Template
# Copy this file to .env in the backend and frontend directories as needed.
# ==============================================================================

# Backend Database Connection
DATABASE_URL=postgresql+psycopg://sat_sa:password@localhost:5432/sat_sa

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000"]

# Authentication & Security
PROJECT_NAME="SAT-SA"
JWT_SECRET=demo-jwt-secret-key-sat-sa-platform-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload Settings
MAX_UPLOAD_SIZE_BYTES=52428800
DATASET_UPLOAD_DIR=uploads/datasets

# Frontend Public API Gateway
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
